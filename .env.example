# Copy to .env and adjust as needed.

# Postgres — nodes (document tree) + doc state (see packages/db/docker-compose.yml)
DATABASE_URL="postgresql://folio:folio@localhost:5432/folio?schema=public"

# Redis — pub/sub for multi-instance awareness + Yjs update fan-out (from S07)
REDIS_URL="redis://localhost:6379"

# API + WS gateway
API_PORT=3001

# Web (Vite dev server)
VITE_API_URL="http://localhost:3001"
VITE_WS_URL="ws://localhost:3001/ws"
