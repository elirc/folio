// Prisma schema for Folio.
// S01: the document skeleton — Node (doc | folder) + DocState (its content, plaintext for now).
// S02: the workspace tree. Node gains a parent (self-relation) and a fractional `sortOrder` among
// siblings; Workspace + Member add tenancy; Acl adds a first-cut per-node role (NO inheritance — that's
// the S11 deep-dive, deliberately deferred). DocState is still PLAINTEXT; by S07 it becomes a Yjs update
// log + snapshots (ADR-0002), which is why content lives on `DocState.text`, not `Node.content`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   Member[]
  nodes     Node[]
}

model Member {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  // Workspace-level default role. A per-node Acl can override it up or down for a specific node.
  role        String    @default("editor") // owner | editor | commenter | viewer
  createdAt   DateTime  @default(now())
  acls        Acl[]

  @@unique([workspaceId, email])
}

model Node {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Self-relation = the tree. parentId null ⇒ a workspace-root node. Cascade delete drops a whole subtree.
  parentId    String?
  parent      Node?     @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Node[]    @relation("NodeChildren")
  type        String    @default("doc") // doc | folder
  title       String    @default("Untitled")
  // Fractional index among siblings (ADR-0003). A move recomputes ONE key — no resequencing.
  // Ported from Tracer S4's keyBetween; see packages/shared/src/order.ts and its rebalancing note.
  sortOrder   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  docState    DocState?
  acls        Acl[]
  comments    Comment[]
  versions    VersionSnapshot[]
  shareLinks  ShareLink[]

  @@index([workspaceId, parentId])
}

// A share link (S11): a scoped capability token granting a role to anyone holding it, until expiry or
// revocation. 🔗 Pulse S10's lesson — expiry + revocation are mandatory (a link without them is a permanent,
// un-auditable backdoor). Layered ON TOP of role-based inheritance.
model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  nodeId    String
  node      Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  role      String    @default("viewer") // owner | editor | commenter | viewer
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([nodeId])
}

// A point-in-time checkpoint of a document (S10). `yState` is a COMPACTED Yjs snapshot (one merged update),
// so reconstructing a version is "apply this one blob" — not "replay a million keystroke-updates". Named
// versions are user "save version" actions; automatic ones are periodic checkpoints. History is *free* from
// the update log — the same log that syncs edits records their sequence. `seq` orders versions per node.
model VersionSnapshot {
  id        String   @id @default(cuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  label     String? // set = named "save version"; null = automatic checkpoint
  kind      String   @default("auto") // auto | named
  yState    Bytes // compacted snapshot of the Y.Doc at this checkpoint
  seq       Int // monotonic version sequence per node
  createdAt DateTime @default(now())

  @@index([nodeId, seq])
}

// A comment anchored to a range of the document (S09). The anchor is an ENCODED Yjs RELATIVE POSITION — it
// tracks the CRDT identity of the text, so it survives concurrent edits (unlike an absolute offset, flaw #3).
// Threads are a self-relation (parentId); resolution is a flag. Deleted-anchor + cross-block edge cases are
// hardened in S13 (a fuzzy-text fallback).
model Comment {
  id        String    @id @default(cuid())
  nodeId    String
  node      Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  author    String
  body      String
  anchor    String // base64 Yjs RelativePosition (start); ranges store start+end in JSON if needed
  resolved  Boolean   @default(false)
  parentId  String? // thread reply → another Comment
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  createdAt DateTime  @default(now())

  @@index([nodeId, resolved])
}

// Per-node access grant. v1: a DIRECT role on a single node — it does NOT flow to descendants.
// Inheritance (a folder's role cascading to everything inside it) is the whole subject of S11.
model Acl {
  id       String @id @default(cuid())
  nodeId   String
  node     Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     String // owner | editor | commenter | viewer

  @@unique([nodeId, memberId])
}

model DocState {
  id        String   @id @default(cuid())
  nodeId    String   @unique
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  // S01–S06: `text` held the document (plaintext, then ProseMirror JSON). S07 adopts Yjs: the CRDT lives in
  // `yUpdate` (an encoded Yjs update = the merged update log). `text` is now the MIGRATION SOURCE (old
  // PM-JSON, read once to seed the Y.Doc) and a periodic human-readable snapshot for export. The name
  // survived the whole journey — plaintext → PM-JSON → Yjs — exactly as ADR-0002 promised.
  text      String   @default("")
  yUpdate   Bytes? // the Yjs document state (S07). Grows as an update log until S12 adds compaction (flaw #4).
  // S14: plain-text PROJECTION of the doc for full-text search — a derived read-path view, updated on change.
  // The CRDT (yUpdate) is the source of truth; this is eventually-consistent (lags a keystroke, by design).
  searchText String  @default("")
  updatedAt DateTime @updatedAt
}
